msgstr "``InitBright``"

msgid "``Logical (.false.)``"
msgstr "``Logical (.false.)``"

msgid ""
"Select optically brightest of ``InitState`` and ``IDark`` as initial state."
msgstr "选择 ``InitState`` 和 ``IDark`` 中光学最亮的态作为初始态。"

msgid "``InitDark``"
msgstr "``InitDark``"

