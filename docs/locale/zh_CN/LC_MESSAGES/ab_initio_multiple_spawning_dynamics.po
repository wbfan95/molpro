msgstr "调整所有初始基函数的动量以匹配第一个基函数的能量。"

msgid "Integration and numerics"
msgstr "积分与数值方法"

msgid "``TimeStep``"
msgstr "``TimeStep``"

msgid "``Real``"
msgstr "``Real``"

msgid "Simulation timestep."
msgstr "模拟时间步长。"

msgid "``SimulationTime``"
msgstr "``SimulationTime``"

msgid "Simulation length."
msgstr "模拟时长。"

msgid "``ExShift``"
msgstr "``ExShift``"

