msgstr "``RPAXII-RCCD`` RPAx-II 计算（同时计算 Szabo-Ostlund 变体 1，参见文献 [3]）。"

msgid "``SO2-RCCD`` Szabo-Ostlund variant 2 (see Ref. [3])."
msgstr "``SO2-RCCD`` Szabo-Ostlund 变体 2（参见文献 [3]）。"

msgid "``SOSEX-RCCD`` dRPA-I+SOSEX correction (see Ref. [3])."
msgstr "``SOSEX-RCCD`` dRPA-I+SOSEX 校正（参见文献 [3]）。"

msgid "``RPAX2-RCCD`` RPAX2 approximation (see Ref. [8])."
msgstr "``RPAX2-RCCD`` RPAX2 近似（参见文献 [8]）。"

msgid "For the PLASMON formulation, the available methods are:"
msgstr "对于 PLASMON 表述，可用的方法有："

msgid "``DRPAI-PLASMON`` dRPA-I calculation (see Ref. [1])."
msgstr "``DRPAI-PLASMON`` dRPA-I 计算（参见文献 [1]）。"

msgid "``RPAXII-PLASMON`` RPAx-II calculation (see Ref. [1])."
msgstr "``RPAXII-PLASMON`` RPAx-II 计算（参见文献 [1]）。"

