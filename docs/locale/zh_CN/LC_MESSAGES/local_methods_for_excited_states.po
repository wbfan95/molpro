msgid "Parameters on LAPLACE card"
msgstr "LAPLACE 卡上的参数"

msgid "``NPOINTS`` Number of quadrature points (default (for CC2) 3)."
msgstr "``NPOINTS`` 积分点数量（默认值（对于 CC2）为 3）。"

msgid ""
"``NULLPOINT`` If larger than zero, use also a Laplace-point with t=0. In "
"case of CC2 is always zero."
msgstr "``NULLPOINT`` 如果大于零，则也使用 t=0 的拉普拉斯点。对于 CC2，此值始终为零。"

msgid "Print options"
msgstr "打印选项"

msgid ""
"Setting ``GPRINT,CIVECTOR=1`` prints the ten largest canonical contributions"
" from singles vectors in each iteration."
msgstr "设置 ``GPRINT,CIVECTOR=1`` 会在每次迭代中打印来自单激发矢量的十个最大正则贡献。"

msgid "``LOCEOM`` :math:`\\geq 0`: print eom domain informations"
msgstr "``LOCEOM`` :math:`\\geq 0`\\ ：打印 eom 域信息"

msgid "``POPUL`` :math:`\\leq 0`: dont print population analysis"
msgstr "``POPUL`` :math:`\\leq 0`\\ ：不打印布居分析"

