msgstr "``PRINT,name,[ncol(1), ncol(2),…]``"

msgid "``PRIO,name,$n_1,n_2,n_3,\\ldots,n_8$``"
msgstr "``PRIO,name,$n_1,n_2,n_3,\\ldots,n_8$``"

msgid "``PRIC,name,[ncol(1), ncol(2),…]``"
msgstr "``PRIC,name,[ncol(1), ncol(2),…]``"

msgid "``ELEM,name,matrix, col,row``"
msgstr "``ELEM,name,matrix, col,row``"

msgid "``POKE,name,matrix, col,row``"
msgstr "``POKE,name,matrix, col,row``"

