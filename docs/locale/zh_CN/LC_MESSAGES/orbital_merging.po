msgstr "examples/no_merge1.inp"

msgid ""
"SCF for the N atom with dummy basis on the O atom, orbitals saved on 2110.2"
msgstr "N 原子的 SCF，O 原子上使用赝基组，轨道保存在 2110.2"

msgid ""
"SCF for the O atom with dummy basis on the N atom, orbitals saved on 2120.2"
msgstr "O 原子的 SCF，N 原子上使用赝基组，轨道保存在 2120.2"

msgid ""
"Merge the atomic SCF orbitals. Finally, obtain the virtual orbitals by "
"projecting the merge orbitals out of the SCF orbitals for NO."
msgstr "合并原子 SCF 轨道。最后，通过将合并轨道从 NO 的 SCF 轨道中投影掉来获得虚轨道。"

msgid "examples/no_merge2.inp"
msgstr "examples/no_merge2.inp"
