"``REGION,METHOD=method,[DEFAULT=default_method], [TYPE=INCLUSIVE|EXCLUSIVE],"
" atom1, atom2 …``"
msgstr ""
"``REGION,METHOD=method,[DEFAULT=default_method], [TYPE=INCLUSIVE|EXCLUSIVE],"
" atom1, atom2 …``"

msgid ""
"``MERGEDOM,[NEIGHBOUR=value],[CENTERS=[atom1, atom2…]], [RECORD=…],CHECK``"
msgstr ""
"``MERGEDOM,[NEIGHBOUR=value],[CENTERS=[atom1, atom2…]], [RECORD=…],CHECK``"

