msgstr "``STATE,nstate,nroot(1),nroot(2),...,nroot(nstate);``"

msgid "``REFSTATE,nstatr,nrootr(1),nrootr(2),...,nrootr(nstatr);``"
msgstr "``REFSTATE,nstatr,nrootr(1),nrootr(2),...,nrootr(nstatr);``"

msgid "``PAIR,iorb1.isy1,iorb2.isy2,np;``"
msgstr "``PAIR,iorb1.isy1,iorb2.isy2,np;``"

msgid "***np=1*:** singlet pair"
msgstr "***np=1*\\ ：** 单态对"

msgid "***np=-1*:** triplet pair"
msgstr "***np=-1*\\ ：** 三重态对"

msgid "***np=0*:** singlet and triplet pair (if possible)"
msgstr "***np=0*\\ ：** 单态和三重态对（如果可能）"

