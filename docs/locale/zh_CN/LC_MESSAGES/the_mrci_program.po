msgid "Cluster corrections for multi-state MRCI"
msgstr "多态MRCI的簇修正"

msgid "In the following, we assume that"
msgstr "在下文中，我们假设"

msgid ""
"\\begin{align}\n"
"\\Psi_{\\rm ref}^{(n)} &=& \\sum_R C_{Rn}^{(0)} \\Phi_R \\\\\n"
"\\Psi_{\\rm mrci}^{(n)} &=& \\sum_R C_{Rn} \\Phi_R + \\Psi_c\\end{align}"
msgstr ""
"\\begin{align}\n"
"\\Psi_{\\rm ref}^{(n)} &=& \\sum_R C_{Rn}^{(0)} \\Phi_R \\\\\n"
"\\Psi_{\\rm mrci}^{(n)} &=& \\sum_R C_{Rn} \\Phi_R + \\Psi_c\\end{align}"

msgid ""
"are the normalized reference and MRCI wave functions for state :math:`n`, "
"respectively. :math:`C_R^{(0)}` are the coefficients of the reference "
"configurations in the initial reference functions and :math:`C_{Rn}` are the"
" relaxed coefficients of these configurations in the final MRCI wave "
"function. :math:`\\Psi_c` is the remainder of the MRCI wave function, which "
"is orthogonal to all reference configurations :math:`\\Phi_R`."
msgstr ""
"\\ 分别是状态 :math:`n` 的归一化参考波函数和MRCI波函数。\\ :math:`C_R^{(0)}` 是初始参考函数中参考组态的系数，\\"
" :math:`C_{Rn}` 是这些组态在最终MRCI波函数中的松弛系数。\\ :math:`\\Psi_c` "
"是MRCI波函数的剩余部分，它与所有参考组态 :math:`\\Phi_R` 正交。"

msgid "The corresponding energies are defined as"
msgstr "相应的能量定义为"

msgid ""
"\\begin{align}\n"
"E_{\\rm ref}^{(n)} &=& \\langle \\Psi_{\\rm ref}^{(n)} | \\hat H | \\Psi_{\\rm ref}^{(n)}\\rangle,\\\\\n"
"E_{\\rm mrci}^{(n)}&=& \\langle \\Psi_{\\rm mrci}^{(n)} | \\hat H | \\Psi_{\\rm mrci}^{(n)}\\rangle.\\end{align}"
msgstr ""
"\\begin{align}\n"
"E_{\\rm ref}^{(n)} &=& \\langle \\Psi_{\\rm ref}^{(n)} | \\hat H | \\Psi_{\\rm ref}^{(n)}\\rangle,\\\\\n"
"E_{\\rm mrci}^{(n)}&=& \\langle \\Psi_{\\rm mrci}^{(n)} | \\hat H | \\Psi_{\\rm mrci}^{(n)}\\rangle.\\end{align}"

msgid ""
"\\begin{align}\n"
"\\Psi_{\\rm rlx}^{(n)} &=& \\frac{\\sum_R C_{Rn} \\Phi_R}{\\sqrt{\\sum_R C_{Rn}^2}},\\end{align}"
msgstr ""
"\\begin{align}\n"
"\\Psi_{\\rm rlx}^{(n)} &=& \\frac{\\sum_R C_{Rn} \\Phi_R}{\\sqrt{\\sum_R C_{Rn}^2}},\\end{align}"

msgid ""
"\\begin{align}\n"
"     \\Psi_{\\rm prj}^{(n)} &=& \\sum_m |\\Psi_{\\rm ref}^{(m)}\\rangle\\langle \\Psi_{\\rm ref}^{(m)} |\\Psi_{\\rm mrci}^{(n)} \\rangle\n"
"      =  \\sum_m |\\Psi_{\\rm ref}^{(m)}\\rangle d_{mn}\\end{align}"
msgstr ""
"\\begin{align}\n"
"     \\Psi_{\\rm prj}^{(n)} &=& \\sum_m |\\Psi_{\\rm ref}^{(m)}\\rangle\\langle \\Psi_{\\rm ref}^{(m)} |\\Psi_{\\rm mrci}^{(n)} \\rangle\n"
"      =  \\sum_m |\\Psi_{\\rm ref}^{(m)}\\rangle d_{mn}\\end{align}"

msgid "with"
msgstr "\\ 其中"

msgid ""
"\\begin{align}\n"
"      d_{mn} &=&  \\langle \\Psi_{\\rm ref}^{(m)}|\\Psi_{\\rm mrci}^{(n)} \\rangle = \\sum_R C_{Rm}^{(0)} C_{Rn}.\\end{align}"
msgstr ""
"\\begin{align}\n"
"      d_{mn} &=&  \\langle \\Psi_{\\rm ref}^{(m)}|\\Psi_{\\rm mrci}^{(n)} \\rangle = \\sum_R C_{Rm}^{(0)} C_{Rn}.\\end{align}"

msgid "These projected functions are not orthonormal. The overlap is"
msgstr "这些投影函数不是正交归一的。其重叠积分为"

msgid ""
"\\begin{align}\n"
"  \\langle  \\Psi_{\\rm prj}^{(m)} |  \\Psi_{\\rm prj}^{(n)} \\rangle &=& ({\\bf d}^{\\dagger} {\\bf d})_{mn}.\\end{align}"
msgstr ""
"\\begin{align}\n"
"  \\langle  \\Psi_{\\rm prj}^{(m)} |  \\Psi_{\\rm prj}^{(n)} \\rangle &=& ({\\bf d}^{\\dagger} {\\bf d})_{mn}.\\end{align}"

msgid ""
"Symmetrical orthonormalization, which changes the functions as little as "
"possible, yields"
msgstr "对称正交归一化（它使函数的改变尽可能小）得到"

msgid ""
"\\begin{align}\n"
"     \\Psi_{\\rm rot}^{(n)} &=& \\sum_m |\\Psi_{\\rm ref}^{(m)}\\rangle u_{mn}, \\\\\n"
"      {\\bf u} &=& {\\bf d} ({\\bf d}^{\\dagger} {\\bf d})^{-1/2}.\\end{align}"
msgstr ""
"\\begin{align}\n"
"     \\Psi_{\\rm rot}^{(n)} &=& \\sum_m |\\Psi_{\\rm ref}^{(m)}\\rangle u_{mn}, \\\\\n"
"      {\\bf u} &=& {\\bf d} ({\\bf d}^{\\dagger} {\\bf d})^{-1/2}.\\end{align}"

msgid "The overlap of these functions with the MRCI wave functions is"
msgstr "这些函数与 MRCI 波函数之间的重叠积分为"

msgid ""
"\\begin{align}\n"
"   \\langle  \\Psi_{\\rm rot}^{(m)} | \\Psi_{\\rm mrci}^{(n)} \\rangle &=&  [({\\bf d}^{\\dagger} {\\bf d}) ({\\bf d}^{\\dagger} {\\bf d})^{-1/2}]_{mn}\n"
"   = [({\\bf d}^{\\dagger} {\\bf d})^{1/2}]_{mn}.\\end{align}"
msgstr ""
"\\begin{align}\n"
"   \\langle  \\Psi_{\\rm rot}^{(m)} | \\Psi_{\\rm mrci}^{(n)} \\rangle &=&  [({\\bf d}^{\\dagger} {\\bf d}) ({\\bf d}^{\\dagger} {\\bf d})^{-1/2}]_{mn}\n"
"   = [({\\bf d}^{\\dagger} {\\bf d})^{1/2}]_{mn}.\\end{align}"

